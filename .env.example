# URL of the JSON API that will eventually be produced by:
# SharePoint Excel -> Power Automate -> JSON API
#
# When unset, the app falls back to local mock data (src/data/mockLeagueData.ts).
# Never commit a real value here.
VITE_LEAGUE_API_URL=

# Optional: base path for GitHub Pages project sites, e.g. /operation-january/
# Leave unset for local development.
VITE_BASE_PATH=

# Mission Hunt backend (Supabase). See MISSION_HUNT_SETUP.md for the full
# setup guide. Leave both unset to show "SETUP REQUIRED" instead of trying to
# connect — the rest of the app works fine without them.
#
# VITE_SUPABASE_ANON_KEY is the public/anon key, safe to expose in a browser
# bundle — it only ever grants what the database's Row Level Security
# policies allow. Never put the service_role key here or anywhere in this
# repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
